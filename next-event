#!/usr/bin/env python3

import hashlib
import json
import os
import re
import subprocess
import sys
from datetime import date, datetime, time, timedelta, timezone
from pathlib import Path
from tempfile import NamedTemporaryFile

import recurring_ical_events
import requests
from icalendar import Calendar


def main():
    arguments = set(sys.argv[1:])
    force_refresh = "--force-refresh" in arguments

    if "--open" in arguments:
        next_event = get_next_event(force_refresh=force_refresh)
        link = extract_link(next_event) if next_event else None
        subprocess.run(["xdg-open", link or "https://calendar.google.com"])
        return

    if "--link" in arguments:
        next_event = get_next_event(force_refresh=force_refresh)
        link = extract_link(next_event) if next_event else None
        print(link or "")
        return

    calendars_file = Path.home() / ".config" / "next-event" / "calendars.txt"
    if not calendars_file.exists():
        output_json(
            {
                "text": "No calendar configured",
                "class": "none",
                "tooltip": "Add calendar URLs to ~/.config/next-event/calendars.txt",
            }
        )
        return

    try:
        events = load_events(force_refresh=force_refresh)
    except Exception as error:
        output_json(
            {
                "text": "Config error",
                "class": "none",
                "tooltip": f"Error reading config: {error}",
            }
        )
        return

    next_event = pick_next_event(events)
    if not next_event:
        output_json(
            {
                "text": "No upcoming events",
                "class": "none",
                "tooltip": "No events found in the next 30 days",
            }
        )
        return

    summary = str(next_event.get("SUMMARY", "Untitled Event"))
    start = next_event["DTSTART"].dt
    hours_until = (
        normalize_datetime(start).astimezone(timezone.utc)
        - datetime.now(timezone.utc)
    ).total_seconds() / 3600

    if hours_until > 3:
        output_json({"text": "", "class": "hidden", "tooltip": ""})
        return

    display_summary = summary[:27] + "..." if len(summary) > 30 else summary
    output_json(
        {
            "text": f"{display_summary} ({get_time_until(start)})",
            "class": get_css_class(start),
            "tooltip": f"{summary}\n{format_time(start)}",
        }
    )


def fetch_ics(url, cache_file, force_refresh=False):
    try:
        prepare_cache_path(cache_file)
    except OSError:
        pass
    cached_data = read_cache(cache_file)
    cached_content = cached_data.get("content", "") if cached_data else ""
    if cached_content and not is_valid_calendar(cached_content):
        cached_content = ""

    if cached_data and cached_content and not force_refresh:
        try:
            cached_time = datetime.fromisoformat(cached_data["timestamp"])
            if cached_time.tzinfo is None:
                cached_time = cached_time.replace(tzinfo=timezone.utc)
            if datetime.now(timezone.utc) - cached_time < timedelta(minutes=5):
                return cached_content
        except (KeyError, TypeError, ValueError):
            pass

    headers = {}
    if cached_content:
        if cached_data.get("etag"):
            headers["If-None-Match"] = cached_data["etag"]
        if cached_data.get("last_modified"):
            headers["If-Modified-Since"] = cached_data["last_modified"]

    try:
        response = requests.get(url, headers=headers, timeout=10)
    except requests.RequestException:
        return cached_content

    if response.status_code == 304 and cached_content:
        cached_data["timestamp"] = datetime.now(timezone.utc).isoformat()
        try:
            write_cache(cache_file, cached_data)
        except OSError:
            pass
        return cached_content

    if response.status_code == 200:
        if not is_valid_calendar(response.text):
            return cached_content

        try:
            write_cache(
                cache_file,
                {
                    "content": response.text,
                    "timestamp": datetime.now(timezone.utc).isoformat(),
                    "etag": response.headers.get("ETag"),
                    "last_modified": response.headers.get("Last-Modified"),
                },
            )
        except OSError:
            pass
        return response.text

    if response.status_code in (408, 429) or response.status_code >= 500:
        return cached_content

    return ""


def calendar_cache_file(cache_dir, url):
    digest = hashlib.sha256(url.encode("utf-8")).hexdigest()
    return cache_dir / f"calendar_{digest}.json"


def extract_link(event):
    link_patterns = [
        r"https://(?:[a-zA-Z0-9-]+\.)*zoom\.us/j/[0-9]+(?:\?[^\s<>\"']*)?",
        r"https://meet\.google\.com/[a-z0-9-]+(?:\?[^\s<>\"']*)?",
        r"https://teams\.microsoft\.com/l/meetup-join/[^\s<>\"']+",
        r"https://(?:[a-zA-Z0-9-]+\.)*webex\.com/[^\s<>\"']+",
        r"https://(?:(?:[a-zA-Z0-9-]+\.)*gotomeeting\.com|meet\.goto\.com)/[^\s<>\"']+",
    ]

    for property_name in ("DESCRIPTION", "LOCATION", "URL"):
        value = re.sub(
            r"&(?:amp|#0*38|#x0*26);",
            "&",
            str(event.get(property_name, "")),
            flags=re.IGNORECASE,
        )
        for pattern in link_patterns:
            match = re.search(pattern, value)
            if match:
                return match.group(0).rstrip(".,;:!?)")

    return None


def pick_next_event(events):
    now = datetime.now(timezone.utc)
    ongoing_events = []
    future_events = []

    for event in events:
        start, end = event_bounds(event)
        if start <= now < end:
            if (now - start).total_seconds() / 60 <= 5:
                return event
            ongoing_events.append((start, event))
        elif start > now:
            future_events.append((start, event))

    if future_events:
        future_events.sort(key=lambda item: item[0])
        return future_events[0][1]

    if ongoing_events:
        ongoing_events.sort(key=lambda item: item[0], reverse=True)
        return ongoing_events[0][1]

    return None


def format_time(value):
    if isinstance(value, date) and not isinstance(value, datetime):
        return value.strftime("%b %d")

    local_value = normalize_datetime(value).astimezone()
    today = datetime.now().astimezone().date()
    if local_value.date() == today:
        return local_value.strftime("%-I:%M %p")

    days_until = (local_value.date() - today).days
    if 0 < days_until <= 7:
        return local_value.strftime("%a %-I:%M %p")

    return local_value.strftime("%b %d %-I:%M %p")


def get_time_until(value):
    diff = (
        normalize_datetime(value).astimezone(timezone.utc)
        - datetime.now(timezone.utc)
    )
    if diff.total_seconds() <= 0:
        minutes_since_start = abs(diff.total_seconds() / 60)
        return "now!" if minutes_since_start <= 5 else "ongoing"

    minutes = int(diff.total_seconds() / 60)
    if minutes < 60:
        return f"{minutes}m"

    hours, remaining_minutes = divmod(minutes, 60)
    if hours < 24:
        if remaining_minutes == 0:
            return f"{hours}h"
        return f"{hours}h {remaining_minutes}m"

    return f"{hours // 24}d"


def get_css_class(value):
    diff = (
        normalize_datetime(value).astimezone(timezone.utc)
        - datetime.now(timezone.utc)
    )
    if diff.total_seconds() <= 0:
        minutes_since_start = abs(diff.total_seconds() / 60)
        return "started" if minutes_since_start <= 5 else "ongoing"

    minutes = diff.total_seconds() / 60
    if minutes <= 10:
        return "soon"
    if minutes <= 30:
        return "warning"
    return "later"


def load_events(force_refresh=False):
    config_dir = Path.home() / ".config" / "next-event"
    calendars_file = config_dir / "calendars.txt"
    cache_dir = Path.home() / ".cache" / "next-event"

    with calendars_file.open(encoding="utf-8") as file:
        urls = []
        for line in file:
            value = line.strip()
            if value and not value.startswith("#"):
                urls.append(value)

    events = []
    for index, url in enumerate(urls):
        ics_content = fetch_ics(
            url,
            calendar_cache_file(cache_dir, url),
            force_refresh=force_refresh,
        )
        if not ics_content:
            continue

        try:
            events.extend(expand_calendar(ics_content))
        except Exception as error:
            print(f"Error parsing calendar {index}: {error}", file=sys.stderr)

    return events


def get_next_event(force_refresh=False):
    try:
        return pick_next_event(load_events(force_refresh=force_refresh))
    except Exception:
        return None


def output_json(event_data):
    print(json.dumps(event_data, ensure_ascii=False))


def normalize_datetime(value):
    if isinstance(value, datetime):
        return value.astimezone() if value.tzinfo is None else value
    return datetime.combine(value, time.min).astimezone()


def event_bounds(event):
    start_value = event["dtstart"].dt
    start = normalize_datetime(start_value)

    if "dtend" in event:
        return start, normalize_datetime(event["dtend"].dt)

    if isinstance(start_value, datetime):
        return start, start + timedelta(hours=1)

    return start, normalize_datetime(start_value + timedelta(days=1))


def prepare_cache_path(cache_file):
    cache_file.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    cache_file.parent.chmod(0o700)
    if cache_file.exists():
        cache_file.chmod(0o600)


def read_cache(cache_file):
    if not cache_file.exists():
        return None
    try:
        with cache_file.open(encoding="utf-8") as file:
            data = json.load(file)
        return data if isinstance(data, dict) else None
    except (OSError, TypeError, ValueError):
        return None


def expand_calendar(content):
    calendar = Calendar.from_ical(content)
    if calendar.name != "VCALENDAR":
        raise ValueError("Calendar feed did not contain a VCALENDAR")

    current_time = datetime.now().astimezone()
    occurrences = recurring_ical_events.of(calendar).between(
        current_time - timedelta(days=1),
        current_time + timedelta(days=30),
    )
    return [
        event
        for event in occurrences
        if str(event.get("STATUS", "")).upper() != "CANCELLED"
    ]


def is_valid_calendar(content):
    try:
        expand_calendar(content)
    except Exception:
        return False
    return True


def write_cache(cache_file, data):
    prepare_cache_path(cache_file)
    temporary_path = None
    try:
        with NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=cache_file.parent,
            prefix=f".{cache_file.name}.",
            delete=False,
        ) as file:
            temporary_path = Path(file.name)
            os.fchmod(file.fileno(), 0o600)
            json.dump(data, file)
        os.replace(temporary_path, cache_file)
    finally:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
